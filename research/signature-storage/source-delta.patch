+/// Fixed conservative lifetimes. Bank6 retires Z6 before receiving T1_7.
+pub const OUTPUT_BANKS: [usize; 16] = [0, 1, 2, 3, 4, 5, 6, 7, 0, 1, 2, 3, 4, 5, 8, 6];
