+/// Terminal diagnostic output. It contains no prover data or transcript.
+pub(crate) struct MainControl<C> {
+    pub root: C,
+    pub lease: crate::composite::Stored,
+    pub fields: Vec<BabyBear>,
+    pub before: Snapshot,
+    pub construction: crate::source::Snapshot,
+    pub unused: [bool; 2],
+}
+impl<D, I, F, R, C> Context<D, I, F, R, C>
+where
+    D: TwoAdicSubgroupDft<BabyBear> + Clone,
+    I: Mmcs<BabyBear, MultiProof: Sync, Error: Sync> + Clone,
+    F: Mmcs<Challenge> + Clone,
+    R: CryptoRng + SeedableRng + Send + Sync,
+    C: FieldChallenger<BabyBear>
+        + GrindingChallenger<Witness = BabyBear>
+        + CanObserve<I::Commitment>
+        + CanObserve<F::Commitment>
+        + CanSample<Challenge>
+        + Clone,
+{
+    /// A fresh positive prefix closes through the original attempt Drop. It
+    /// cannot be resumed and never calls finish_produced or an opening entry.
+    pub(crate) fn main_control(
+        &self,
+        values: impl IntoIterator<Item = Result<BabyBear, kova_fallible_input::Error>>,
+    ) -> Result<MainControl<I::Commitment>, OwnedError> {
+        use crate::composite::Step;
+        use p3_commit::Pcs;
+        if cfg!(debug_assertions) {
+            return Err(OwnedError::ReleaseRequired);
+        }
+        self.config.pcs().composite_profile()?;
+        if self.config.ood_proof_of_work_bits() != 0
+            || self.config.lookup_proof_of_work_bits() != 0
+            || self.config.is_zk() != 1
+        {
+            return Err(OwnedError::Context);
+        }
+        let raw = self.store.try_write_raw(values)?;
+        let attempt = self.store.begin_attempt(&raw)?;
+        let mut step = Step::new(&self.store);
+        let result: Result<_, OwnedError> = (|| {
+            let pcs = self.config.pcs();
+            let domain = <HidingFriPcs<BabyBear, D, I, F, R, CompositeStore> as Pcs<
+                Challenge,
+                C,
+            >>::natural_domain_for_degree(pcs, 512);
+            let (root, data) = pcs.commit_composite_main(domain, raw)?;
+            let (lease, fields) = pcs.observe_main_data(&data)?;
+            let unused = pcs.main_opening_unused(&data);
+            let before = self.store.snapshot()?;
+            let construction = self.construction_snapshot()?;
+            Ok((root, data, lease, fields, unused, before, construction))
+        })();
+        match &result {
+            Ok(_) => step.done = true,
+            Err(error) => {
+                let cause = match error {
+                    OwnedError::Storage { source, .. } => source.clone(),
+                    OwnedError::Backend(ProvingError::Pcs { source, .. }) => Error::Mask(*source),
+                    _ => Error::Incomplete,
+                };
+                step.fail(cause);
+            }
+        }
+        // Successful partial work is intentionally closed, with the original
+        // Unwind marker recording that this was not a completed proving attempt.
+        drop(attempt);
+        result.map(
+            |(root, data, lease, fields, unused_before, before, construction)| {
+                let unused_after = self.config.pcs().main_opening_unused(&data);
+                drop(data);
+                MainControl {
+                    root,
+                    lease,
+                    fields,
+                    before,
+                    construction,
+                    unused: [unused_before, unused_after],
+                }
+            },
+        )
+    }
+}
