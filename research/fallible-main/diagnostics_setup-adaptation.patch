+// Observe real commit preimages while forwarding the identical iterator to
+// the retained hash. This supplies neither expected fields nor a root verdict.
+#[derive(Clone)]
+pub(super) struct CapturingLeaf(Arc<Audit>);
+impl CryptographicHasher<BabyBear, [u64; 8]> for CapturingLeaf {
+    fn hash_iter<T: IntoIterator<Item = BabyBear>>(&self, input: T) -> [u64; 8] {
+        let mut row = [0u8; 88];
+        let mut fields = 0usize;
+        let digest = hash::LeafHash.hash_iter(input.into_iter().inspect(|value| {
+            assert!(fields < 22, "fixed salted main width");
+            row[4 * fields..4 * fields + 4]
+                .copy_from_slice(&value.as_canonical_u32().to_le_bytes());
+            fields += 1;
+        }));
+        assert_eq!(fields, 22);
+        let mut capture = self.0.leaves.lock().unwrap();
+        let bytes = capture.get_or_insert_with(|| Vec::with_capacity(360448));
+        assert!(bytes.len() <= 360448 - 88, "fixed main leaf count");
+        bytes.extend_from_slice(&row);
+        digest
+    }
+}
